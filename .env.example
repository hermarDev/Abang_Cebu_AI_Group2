# ==============================================================================
# AbangCebuAI Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env.local to GitHub. See docs/environment-variables.md for rules.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-EXPOSED VARIABLES (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Inlined into browser JavaScript bundles at build time.
# NEVER put secret database passwords or private service keys here!

# Supabase Public API Endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Protected by Supabase Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical application origin used to construct email verification callbacks.
# Set this to the deployed HTTPS application origin outside local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Turnstile verification secret. Keep TURNSTILE_SECRET_KEY private.
TURNSTILE_SECRET_KEY=

# Public Cloudflare Turnstile site key used by the sign-in widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared Redis REST configuration used by registration abuse protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MapLibre Map Style Specification
# Defaults to local OpenStreetMap Standard Raster Tiles (/styles/osm.json)
NEXT_PUBLIC_MAP_STYLE_URL=/styles/osm.json


# ------------------------------------------------------------------------------
# 2. STRICTLY SERVER-SIDE VARIABLES (Confidential)
# ------------------------------------------------------------------------------
# Accessible ONLY in Node.js server runtime, Server Components, and Server Actions.
# NEVER prefix with NEXT_PUBLIC_!

# Supabase Service Role Key (Admin Master Key - Bypasses RLS)
# Leave blank for local UI development unless executing admin seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
