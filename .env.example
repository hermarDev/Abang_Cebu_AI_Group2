# ==============================================================================
# AbangCebuAI Environment Configuration
# ==============================================================================

# Supabase Connection
# Obtain these from your Supabase Dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (STRICTLY SERVER-SIDE ONLY - Never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MapLibre Map Style
# Configured for Option A: OpenStreetMap Standard Raster Tiles (100% Free & Keyless)
NEXT_PUBLIC_MAP_STYLE_URL=/styles/osm.json
