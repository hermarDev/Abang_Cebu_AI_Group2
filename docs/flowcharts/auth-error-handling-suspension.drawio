<mxfile host="app.diagrams.net" modified="2026-10-01T13:40:00.000Z" agent="AbangCebuAI Architect" version="21.0.0" type="device"><diagram id="auth-error-handling-suspension" name="Sub-Process 5: Error Handling, Security Defenses &amp; Account Suspension"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_card" value="&lt;b&gt;AbangCebu AI — Sub-Process 5: Error Handling, Security Defenses &amp; Account Suspension&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;28-Code Taxonomy, UX Feedback Surfaces &amp; Real-Time Suspension Eviction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="40" width="900" height="60" /></mxCell><mxCell id="node_Start" value="Auth Exception or Administrative Action Triggered" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="140" width="300" height="50" /></mxCell><mxCell id="node_CatchError" value="Auth Interceptor Normalizes Error to StandardAuthError Schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="235" width="320" height="55" /></mxCell><mxCell id="node_ClassifyTaxonomy" value="Classify Error Code across 28-Code System Taxonomy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="330" width="320" height="55" /></mxCell><mxCell id="node_FeedbackMode" value="