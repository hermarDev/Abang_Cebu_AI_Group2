<mxfile host="app.diagrams.net" modified="2026-10-01T13:40:00.000Z" agent="AbangCebuAI Architect" version="21.0.0" type="device"><diagram id="auth-login-session-rtr" name="Sub-Process 2: User Login &amp; Session Token Lifecycle"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_card" value="&lt;b&gt;AbangCebu AI — Sub-Process 2: User Login &amp; Session Token Lifecycle&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;Argon2id Credentials, Dual Lifespan Cookies &amp; Refresh Token Rotation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="40" width="900" height="60" /></mxCell><mxCell id="node_Start" value="User Navigates to Login Page (/login)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="140" width="300" height="50" /></mxCell><mxCell id="node_InputCreds" value="Enter Email, Password, Turnstile Token, Remember Me Toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="235" width="320" height="55" /></mxCell><mxCell id="node_RateLimit" value="Rate Limit Check: Failed Attempts &gt;= 5 in 15 Minutes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="330" width="340" height="70" /></mxCell><mxCell id="node_BlockLockout" value="HTTP 429 RATE_LIMIT_EXCEEDED: Enforce 15-Minute IP Cooldown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="425" width="320" height="55" /></mxCell><mxCell id="node_ServerAuth" value="Server Action loginUserAction Invokes Supabase signInWithPassword()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="520" width="320" height="55" /></mxCell><mxCell id="node_CredsValid" value="Argon2id / Bcrypt Password Hash Matches auth.users?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="615" width="340" height="70" /></mxCell><mxCell id="node_ShowErrCreds" value="HTTP 401 AUTH_INVALID_CREDENTIALS: 'Invalid email or password'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="710" width="320" height="55" /></mxCell><mxCell id="node_ConfCheck" value="Account Email Confirmed (email_confirmed_at IS NOT NULL)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="805" width="340" height="70" /></mxCell><mxCell id="node_BlockUnconf" value="HTTP 403 AUTH_EMAIL_NOT_CONFIRMED: Render Resend Link Banner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="900" width="320" height="55" /></mxCell><mxCell id="node_SuspCheck" value="Account Suspended (profiles.is_suspended == true)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="995" width="340" height="70" /></mxCell><mxCell id="node_BlockSusp" value="HTTP 403 ACCOUNT_SUSPENDED: Terminate Session &amp; Route to Support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1090" width="320" height="55" /></mxCell><mxCell id="node_IssueJWT" value="Issue 1-Hour JWT Access Token + Single-Use Refresh Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1185" width="320" height="55" /></mxCell><mxCell id="node_CookieWrite" value="Write Chunked HTTP-Only Cookies (7-Day Standard vs 30-Day Remember Me)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1280" width="320" height="55" /></mxCell><mxCell id="node_RTRCheck" value="Edge Middleware Interception: Token TTL &lt; 300s During Page Load?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="1375" width="340" height="70" /></mxCell><mxCell id="node_RotateToken" value="Silent GoTrue Refresh: Rotate Refresh Token (30s Concurrency Leeway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1470" width="320" height="55" /></mxCell><mxCell id="node_ReplayGuard" value="Was Rotated Refresh Token Reused Past 30s Grace Period?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="1565" width="340" height="70" /></mxCell><mxCell id="node_RevokeFamily" value="Replay Attack Detected: Revoke Token Family &amp; Invalidate All Sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1660" width="320" height="55" /></mxCell><mxCell id="node_End" value="Route User to Target (/search for Renter, /dashboard for Landlord)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#0D9488;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="1755" width="300" height="50" /></mxCell><mxCell id="edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_Start" target="node_InputCreds" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_InputCreds" target="node_RateLimit" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_2" value="Yes (Brute Force)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_RateLimit" target="node_BlockLockout" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_3" value="No (Within Limit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_RateLimit" target="node_ServerAuth" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_ServerAuth" target="node_CredsValid" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_CredsValid" target="node_ShowErrCreds" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_CredsValid" target="node_ConfCheck" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_ConfCheck" target="node_BlockUnconf" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_ConfCheck" target="node_SuspCheck" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_9" value="Yes (Suspended)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_SuspCheck" target="node_BlockSusp" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_10" value="No (Active)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_SuspCheck" target="node_IssueJWT" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_IssueJWT" target="node_CookieWrite" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_CookieWrite" target="node_RTRCheck" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_13" value="Yes (&lt;300s TTL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_RTRCheck" target="node_RotateToken" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_14" value="No (Fresh Token)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_RTRCheck" target="node_End" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_RotateToken" target="node_ReplayGuard" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_16" value="Yes (Reused Token)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F