<mxfile host="app.diagrams.net" modified="2026-10-01T13:40:00.000Z" agent="AbangCebuAI Architect" version="21.0.0" type="device"><diagram id="auth-password-reset-recovery" name="Sub-Process 3: Password Reset &amp; Self-Service Recovery"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_card" value="&lt;b&gt;AbangCebu AI — Sub-Process 3: Password Reset &amp; Self-Service Recovery&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;Anti-Enumeration Jitter, PKCE Recovery Link &amp; Global Device Revocation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="40" width="900" height="60" /></mxCell><mxCell id="node_Start" value="User Navigates to Forgot Password (/forgot-password)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="140" width="300" height="50" /></mxCell><mxCell id="node_SubmitEmail" value="Submit Email Address + Cloudflare Turnstile Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="235" width="320" height="55" /></mxCell><mxCell id="node_RateLimit" value="Rate Limit Check: &gt; 3 Requests in 15 Minutes for Email?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="330" width="340" height="70" /></mxCell><mxCell id="node_BlockRate" value="HTTP 429 AUTH_PASSWORD_RESET_RATE_LIMIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="425" width="320" height="55" /></mxCell><mxCell id="node_ServerLookup" value="POST /api/auth/reset-password/request Ingests Payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="520" width="320" height="55" /></mxCell><mxCell id="node_JitterDelay" value="Apply Synthetic Latency Jitter (200ms - 400ms Delay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="615" width="320" height="55" /></mxCell><mxCell id="node_AntiEnum" value="Return Identical Generic HTTP 200 OK ('If account exists, link sent')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="710" width="320" height="55" /></mxCell><mxCell id="node_EmailFound" value="Does Target Email Exist in auth.users Database?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="805" width="340" height="70" /></mxCell><mxCell id="node_SendLink" value="Supabase GoTrue Dispatches 60-Minute Single-Use PKCE Recovery Email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="900" width="320" height="55" /></mxCell><mxCell id="node_NoOp" value="Drop Request Silently (Zero Account Disclosure to Scrapers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="995" width="320" height="55" /></mxCell><mxCell id="node_ClickRecovery" value="User Clicks Email Link -&gt; /auth/callback?code=CODE&amp;type=recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1090" width="320" height="55" /></mxCell><mxCell id="node_ScopedSession" value="Route Handler Exchanges Code for Temporary Scoped Recovery Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1185" width="320" height="55" /></mxCell><mxCell id="node_EnterNewPass" value="Render /reset-password Form (Enter New Password &amp; Confirmation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1280" width="320" height="55" /></mxCell><mxCell id="node_NISTCheck" value="NIST SP 800-63B Complexity &amp; Password Parity Match Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="1375" width="340" height="70" /></mxCell><mxCell id="node_CommitPass" value="Supabase updateUser({ password }) Commits New Argon2id Hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1470" width="320" height="55" /></mxCell><mxCell id="node_GlobalRevoke" value="Mandatory Global Session Invalidation: auth.signOut({ scope: 'global' })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1565" width="320" height="55" /></mxCell><mxCell id="node_BroadcastSync" value="Emit SIGNED_OUT Event over BroadcastChannel('supabase.auth.token')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="1660" width="320" height="55" /></mxCell><mxCell id="node_End" value="Redirect to /login?message=password_reset_success" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#0D9488;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="1755" width="300" height="50" /></mxCell><mxCell id="edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_Start" target="node_SubmitEmail" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_SubmitEmail" target="node_RateLimit" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" source="node_RateLimit" target="node_BlockRate" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F172A;strokeWidth=1.5;fontS