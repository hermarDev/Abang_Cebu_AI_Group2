<mxfile host="app.diagrams.net" modified="2026-10-01T13:40:00.000Z" agent="AbangCebuAI Architect" version="21.0.0" type="device"><diagram id="auth-signout-multitab" name="Sub-Process 4: User Sign-Out &amp; Multi-Tab Synchronization"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_card" value="&lt;b&gt;AbangCebu AI — Sub-Process 4: User Sign-Out &amp; Multi-Tab Synchronization&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;Scope Invalidation, Cookie Zeroing &amp; Real-Time HTML5 BroadcastChannel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="40" width="900" height="60" /></mxCell><mxCell id="node_Start" value="User Triggers Sign Out in Primary Browser (Tab A)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="140" width="300" height="50" /></mxCell><mxCell id="node_ScopeFork" value="Determine Invalidation Scope: 'local' vs 'global'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="235" width="340" height="70" /></mxCell><mxCell id="node_LocalRevoke" value="Execute signOutAction({ scope: 'local' }) (Active Device Only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="330" width="320" height="55" /></mxCell><mxCell id="node_GlobalRevoke" value="Execute signOutAction({ scope: 'global' }) (All Active Devices)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="425" width="320" height="55" /></mxCell><mxCell id="node_PurgeDBSession" value="Supabase GoTrue Deletes auth.sessions Row &amp; Revokes Refresh Lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="520" width="320" height="55" /></mxCell><mxCell id="node_ScanCookies" value="Server Scans Cookie Jar for Base Name sb-*-auth-token &amp; Chunks .0, .1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="615" width="320" height="55" /></mxCell><mxCell id="node_ZeroCookies" value="Emit Set-Cookie Directives with Max-Age=0 and Expired Epoch (1970)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="710" width="320" height="55" /></mxCell><mxCell id="node_EmitHeaders" value="Set HTTP Header: Clear-Site-Data: 'cache', 'cookies', 'storage'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="805" width="320" height="55" /></mxCell><mxCell id="node_EmitBroadcast" value="BroadcastChannel('supabase.auth.token').postMessage({ type: 'SIGNED_OUT' })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="900" width="320" height="55" /></mxCell><mxCel